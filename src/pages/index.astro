---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import pawel01 from "../assets/pawel-01.jpg";
import pawel02 from "../assets/pawel-02.jpg";
import pawel03 from "../assets/pawel-03.jpg";
---

<Layout>
  <main id="main">
    <!-- ── Hero ──────────────────────────────────────────── -->
    <section class="hero">
      <header class="hero-header">
        <span class="mono dim">PAWEŁ JARMOŁKOWICZ</span>
        <span class="mono dim">INNOVATION CONSULTANT &amp; RESEARCHER</span>
      </header>

      <div class="hero-body">
        <h1>
          I care about what<br />
          technology does<br />
          <em class="amber">to</em> people.<span class="cursor">|</span>
        </h1>
        <p class="hero-sub">Not only what it does for them.</p>
      </div>

      <footer class="hero-footer">
        <div class="hero-rule"></div>
        <nav class="hero-meta" aria-label="Sections">
          <a class="mono" href="#work"><span class="amber">01</span>&nbsp;WORK</a>
          <a class="mono" href="#research"><span class="amber">02</span>&nbsp;RESEARCH</a>
          <a class="mono" href="#background"><span class="amber">03</span>&nbsp;BACKGROUND</a>
          <a class="mono" href="#recognition"><span class="amber">04</span>&nbsp;RECOGNITION</a>
        </nav>
      </footer>
    </section>

    <!-- ── Work ───────────────────────────────────────────── -->
    <section class="spotlight reveal" id="work">
      <div class="spotlight-spine">
        <span>// 01 — WORK</span>
      </div>
      <div class="spotlight-content">
        <h2>What I do.</h2>
        <p>
          I'm an innovation consultant. Twenty years across technology,
          research, and strategy — most of it in healthcare and life sciences.
          I work on innovation and product strategy.
        </p>
        <p>
          AI has been part of my own work for a few years now. I noticed it
          changing my work, and me. So I started researching how it changes
          knowledge work and what it does to the rest of us. That research is
          <a href="#research" class="underlink">Modrn Mind</a>, below.
        </p>
        <span class="border-line"></span>
        <p>
          I help bring AI into consulting work, building on my own experience
          and research. I run the training and change how the work actually
          gets done.
        </p>
        <a
          href="https://calendar.app.google/T1xR4TFERp7Xuy7K7"
          class="btn"
          target="_blank"
          rel="noopener">Let's talk →</a
        >
      </div>
      <div class="spotlight-image">
        <Image
          src={pawel01}
          alt="Paweł Jarmołkowicz, innovation consultant and researcher"
          widths={[480, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 38vw"
          loading="eager"
        />
      </div>
    </section>

    <!-- ── Research ───────────────────────────────────────── -->
    <section class="research reveal" id="research">
      <div class="research-ghost" aria-hidden="true">MM</div>
      <div class="research-spine">
        <span>// 02 — RESEARCH</span>
      </div>
      <div class="research-content">
        <h2>What I'm figuring out.</h2>
        <p>
          I started using LLMs when ChatGPT 3.5 launched in late 2022. Soon
          after, I noticed I couldn't recall details of my AI-assisted work. I
          was seeking confirmation from AI on things I was good at before. I was
          losing my ability to think on my own. Then I realized this wasn't just
          happening to me.
        </p>
        <p>
          Modrn Mind (yes, no "e") is my research into what AI does to those of
          us who think for a living. I look at how AI use affects our agency,
          judgment, and relationships, and what keeps our work valuable as AI
          does more. It's an attempt to help people notice this pattern in
          themselves and do something about it. The research lives in an open
          knowledge base on GitHub, and it's becoming a book.
        </p>
        <a
          href="https://modrnmind.com"
          class="btn btn--amber"
          target="_blank"
          rel="noopener">Explore the Knowledge Base →</a
        >
        <div class="recent-articles">
          <span class="recent-articles-label mono dim">Selected writing</span>
          <ul>
            <li>
              <a
                href="https://read.modrnmind.com/p/charting-the-course-strategic-transformation"
                target="_blank"
                rel="noopener"
                class="underlink"
                >Charting the Course: Strategic Transformation for Software
                Agencies in the AI Economy</a
              >
              <span class="article-desc"
                >why software agencies have to move from commodity delivery to
                the value only people can create</span
              >
            </li>
            <li>
              <a
                href="https://read.modrnmind.com/p/the-human-edge-cultivating-the-human"
                target="_blank"
                rel="noopener"
                class="underlink"
                >The Human Edge: Cultivating the Human Wisdom AI Can't Automate</a
              >
              <span class="article-desc"
                >as AI takes over the craft, the premium shifts to the human
                wisdom it can't copy</span
              >
            </li>
            <li>
              <a
                href="https://read.modrnmind.com/p/the-one-calibration-question-that"
                target="_blank"
                rel="noopener"
                class="underlink"
                >The One Calibration Question That Changes How You Use AI</a
              >
              <span class="article-desc"
                >before each prompt, ask how much of you the task actually
                requires</span
              >
            </li>
            <li>
              <a
                href="https://read.modrnmind.com/p/why-ai-productivity-feels-like-a"
                target="_blank"
                rel="noopener"
                class="underlink"
                >Why AI Productivity Feels Like a Trap (and What to Do About It)</a
              >
              <span class="article-desc"
                >your output gets better while you quietly get worse, and how to
                tell the difference</span
              >
            </li>
          </ul>
        </div>
      </div>
      <div class="research-image">
        <Image
          src={pawel02}
          alt="Paweł Jarmołkowicz, creator of Modrn Mind, research on AI and human thinking"
          widths={[480, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 38vw"
          loading="lazy"
        />
      </div>
    </section>

    <!-- ── Background ─────────────────────────────────────── -->
    <section class="background reveal" id="background">
      <div class="bg-ghost" aria-hidden="true">20</div>
      <div class="background-spine">
        <span>// 03 — BACKGROUND</span>
      </div>
      <div class="background-content">
        <h2>Twenty years.<br />Still curious.</h2>
        <p class="bg-intro">
          Different fields, but it's the same problem I still work on. New
          technology only pays off when the people and the business move with
          it.
        </p>
        <div class="bg-portfolio">
          <details class="bg-group" name="bg-accordion" open>
            <summary class="bg-category">// Inventing products</summary>
            <div class="bg-entries">
              <div class="bg-entry">
                <h3>Detecting autism from the way a child plays</h3>
                <p>
                  Children play a game. The game captures fine motor patterns:
                  timing, pressure, movement. ML models analyze those patterns
                  for early signs of autism. A diagnostic tool disguised as
                  play, designed for children too young to answer questions.
                </p>
              </div>
              <div class="bg-entry">
                <h3>Turning a phone into a blood lab</h3>
                <p>
                  Miniaturizing satellite hyperspectral imaging into a
                  smartphone dongle. Point it at a blood sample, create a
                  digital spectral cube, transmit it to the cloud for analysis,
                  receive a diagnosis. Designed for places with mobile
                  connectivity but no laboratory infrastructure.
                </p>
              </div>
              <div class="bg-entry">
                <h3>Rapid STD testing in a ring</h3>
                <p>
                  A wearable medical device with a replaceable cartridge
                  containing microneedles and a biochip, testing for four common
                  STDs in minutes. No clinic, no lab, no waiting.
                </p>
              </div>
            </div>
          </details>

          <details class="bg-group" name="bg-accordion">
            <summary class="bg-category">// Proving it works</summary>
            <div class="bg-entries">
              <div class="bg-entry">
                <h3>From hypothesis to Phase 3 clinical trial</h3>
                <p>
                  Starting with exploratory studies. Refining the ML models.
                  Publishing in peer-reviewed journals. Replicating results.
                  Then a Phase 3 clinical trial in 760 children across the UK
                  and Sweden. A new diagnostic paradigm needs to be proven
                  before anyone will trust it. Building that proof, one study at
                  a time.
                </p>
              </div>
              <div class="bg-entry">
                <h3>Will the model hold in the real world?</h3>
                <p>
                  ML tools trained in controlled research settings perform
                  differently when deployed in real environments. Different
                  devices, different lighting, different operator behavior.
                  Predicting and managing that gap before it becomes a product
                  failure.
                </p>
              </div>
              <div class="bg-entry">
                <h3>Building a global research network</h3>
                <p>
                  Setting up and maintaining collaborations with universities,
                  research centers, and therapeutic centers across multiple
                  countries. Each with their own agendas and timelines. Building
                  the agreements to make joint research possible and align
                  interests.
                </p>
              </div>
            </div>
          </details>

          <details class="bg-group" name="bg-accordion">
            <summary class="bg-category">// Making new things pay</summary>
            <div class="bg-entries">
              <div class="bg-entry">
                <h3>A business model for something that doesn't exist yet</h3>
                <p>
                  Building a commercial model for a digital health product with
                  no category in any healthcare reimbursement framework, no
                  established buyer, and nothing comparable to point to.
                </p>
              </div>
              <div class="bg-entry">
                <h3>How to create value before the science is complete</h3>
                <p>
                  Scientific and clinical validation takes years, leaving the
                  question of how to start being useful to users, building trust
                  with practitioners, and staying financially alive while the
                  evidence base is still being built.
                </p>
              </div>
              <div class="bg-entry">
                <h3>When clients want ML but aren't ready for it</h3>
                <p>
                  Companies arrive asking for machine learning. What they
                  actually need first: clean data, infrastructure to move it,
                  people who know what to do with it. Building the foundations
                  that make ML possible before ML itself.
                </p>
              </div>
            </div>
          </details>

          <details class="bg-group" name="bg-accordion">
            <summary class="bg-category">// Changing how companies work</summary>
            <div class="bg-entries">
              <div class="bg-entry">
                <h3>Selling something a sales team doesn't understand</h3>
                <p>
                  Getting a sales organization to sell data and ML services when
                  they don't understand what they're selling, and their bonuses
                  depend on services they already know how to close.
                </p>
              </div>
              <div class="bg-entry">
                <h3>Turning a software company into an advisory firm</h3>
                <p>
                  Shifting a company that competes on execution and price toward
                  competing on value and results. Different positioning,
                  different talent, different sales process, different client
                  relationship.
                </p>
              </div>
              <div class="bg-entry">
                <h3>Staying fast while becoming certifiable</h3>
                <p>
                  ISO 13485 demands documentation, process control, and audit
                  trails. Getting certified without turning the company into
                  something slow and risk-averse. Building the quality system
                  around maintaining speed and flexibility to explore new ideas.
                </p>
              </div>
            </div>
          </details>
        </div>
      </div>
      <div class="background-image">
        <Image
          src={pawel03}
          alt="Paweł Jarmołkowicz, twenty years across technology, research, and strategy"
          widths={[480, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 38vw"
          loading="lazy"
        />
      </div>
    </section>

    <!-- ── Recognition ────────────────────────────────────── -->
    <section class="recognition reveal" id="recognition">
      <div class="recognition-spine">
        <span>// 04 — RECOGNITION</span>
      </div>
      <div class="recognition-content">
        <h2>Some of the work got noticed.</h2>
        <div class="rec-table">
          <div class="rec-row">
            <span class="rec-num amber">01</span>
            <div class="rec-body">
              <h3>MIT Innovator Under 35</h3>
              <p>
                Named by MIT Technology Review for work on early autism
                screening using AI and games.
              </p>
            </div>
          </div>
          <div class="rec-row">
            <span class="rec-num amber">02</span>
            <div class="rec-body">
              <h3>New Europe 100 Challengers</h3>
              <p>
                Selected by Google and the Financial Times as one of New
                Europe's 100 most innovative changemakers.
              </p>
            </div>
          </div>
          <div class="rec-row">
            <span class="rec-num amber">03</span>
            <div class="rec-body">
              <h3>Singularity University Fellow</h3>
              <p>
                Nine weeks at NASA Ames Research Park, working with leaders from
                around the world on humanity's hardest problems.
              </p>
            </div>
          </div>
          <div class="rec-row">
            <span class="rec-num amber">04</span>
            <div class="rec-body">
              <h3>TEDx Speaker</h3>
              <p>
                Spoke at TEDxKrakow on entrepreneurs using business as a force
                for genuine good.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ── Footer ─────────────────────────────────────────── -->
  <footer class="footer">
    <span class="amber">_</span>&nbsp;
    <a href="mailto:pawel@jarmolkowicz.com">pawel@jarmolkowicz.com</a>
    &nbsp;·&nbsp;
    <a href="https://modrnmind.com" target="_blank" rel="noopener"
      >modrnmind.com</a
    >
    &nbsp;·&nbsp;
    <a
      href="https://www.linkedin.com/in/jarmolkowicz/"
      target="_blank"
      rel="noopener">linkedin</a
    >
  </footer>
</Layout>

<style>
  /* ── Shared: spine ───────────────────────────────────── */
  .spotlight-spine,
  .research-spine,
  .background-spine,
  .recognition-spine {
    border-right: 1px solid var(--border);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 0;
  }

  .background-spine,
  .recognition-spine {
    align-items: flex-start;
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .research-spine,
  .background-spine {
    z-index: 1;
  }

  .spotlight-spine span,
  .research-spine span,
  .background-spine span,
  .recognition-spine span {
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.15em;
    color: var(--amber);
    writing-mode: vertical-lr;
    transform: rotate(180deg);
    white-space: nowrap;
    text-transform: uppercase;
  }

  /* ── Shared: section heading ──────────────────────────── */
  .spotlight-content h2,
  .research-content h2,
  .background-content h2,
  .recognition-content h2 {
    font-family: var(--serif);
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    font-style: italic;
    font-weight: 300;
    font-variation-settings:
      "opsz" 72,
      "WONK" 1;
    line-height: 1.1;
  }

  .spotlight-content h2 {
    margin-bottom: 0.5rem;
  }
  .research-content h2 {
    color: var(--amber);
    margin-bottom: 0.5rem;
  }
  .background-content h2 {
    line-height: 1.15;
  }
  .recognition-content h2 {
    margin-bottom: 2rem;
  }

  /* ── Max-width cap ───────────────────────────────────── */
  main,
  .footer {
    max-width: 1440px;
    margin-inline: auto;
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 2rem var(--edge);
    border-bottom: 1px solid var(--border);
  }

  .hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 0;
  }

  .hero-body h1 {
    font-family: var(--serif);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 300;
    font-style: italic;
    font-variation-settings:
      "opsz" 144,
      "WONK" 1;
    line-height: 1;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }

  .hero-body h1 .amber {
    font-style: normal;
    font-variation-settings:
      "opsz" 144,
      "WONK" 1;
  }

  .hero-sub {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.8vw, 2.25rem);
    font-style: italic;
    font-weight: 300;
    font-variation-settings: "opsz" 72;
    color: var(--dim);
    margin-top: 1.25rem;
    max-width: none;
  }

  .hero-footer {
    padding-top: 2rem;
  }

  .hero-rule {
    width: 100%;
    height: 1px;
    background: var(--border);
    margin-bottom: 1.5rem;
    position: relative;
  }

  .hero-rule::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(3rem, 8vw, 7rem);
    height: 1px;
    background: var(--amber);
  }

  .hero-meta {
    display: flex;
    justify-content: flex-start;
    gap: 2.5rem;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.15em;
  }

  .hero-meta a {
    color: var(--text);
    transition: color 0.2s;
  }

  .hero-meta a:hover {
    color: var(--amber);
  }

  /* ── Button ───────────────────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 0.875rem 1.875rem;
    border: 1px solid var(--dim);
    font-family: var(--mono);
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    color: var(--text);
    background: transparent;
    transition:
      border-color 0.2s,
      color 0.2s,
      background 0.2s;
    white-space: nowrap;
  }

  .btn:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .btn--amber {
    border-color: var(--amber);
    color: var(--amber);
  }

  .btn--amber:hover {
    background: var(--amber);
    color: var(--bg);
  }

  /* ── Work ─────────────────────────────────────────────── */
  .spotlight {
    display: grid;
    grid-template-columns: 3rem 1fr 38%;
    min-height: 72vh;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .spotlight-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem);
    gap: 1rem;
  }

  .spotlight-content p {
    color: var(--dim);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .spotlight-content ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .spotlight-content ul li {
    font-size: 1.0625rem;
    color: var(--dim);
    padding-left: 1.5rem;
    position: relative;
  }

  .spotlight-content ul li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--amber);
    font-size: 0.875rem;
  }

  .underlink {
    color: var(--text);
    border-bottom: 1px solid var(--dim-2);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .underlink:hover {
    color: var(--amber);
    border-color: var(--amber);
  }

  /* ── Research ─────────────────────────────────────────── */
  .research {
    display: grid;
    grid-template-columns: 3rem 1fr 38%;
    min-height: 72vh;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    position: relative;
    background: var(--bg-2);
  }

  .research-ghost {
    position: absolute;
    right: 38%;
    top: 50%;
    transform: translateY(-50%) translateX(30%);
    font-family: var(--serif);
    font-size: 28vw;
    font-weight: 900;
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px rgba(232, 160, 32, 0.07);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .research-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem);
    gap: 1rem;
    z-index: 1;
  }

  .research-content p {
    color: var(--dim);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .border-line {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .recent-articles {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .recent-articles-label {
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .recent-articles ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .recent-articles ul li {
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .all-essays-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    transition: color 0.2s;
  }

  .all-essays-link:hover {
    color: var(--amber);
  }

  .article-desc {
    display: block;
    font-size: 0.875rem;
    color: var(--dim);
    line-height: 1.5;
    margin-top: 0.2rem;
  }

  /* ── Section images ───────────────────────────────────── */
  .spotlight-image,
  .research-image {
    overflow: hidden;
    border-left: 1px solid var(--border);
  }

  .spotlight-image {
    background: var(--bg);
  }
  .research-image {
    background: var(--bg);
    z-index: 1;
  }

  .spotlight-image img,
  .research-image img,
  .background-image img {
    object-position: center top;
  }

  .research-image img {
    opacity: 0.7;
  }

  /* Background image: absolutely positioned with a fixed viewport height
     so accordion height changes don't resize the photo.
     Section overflow:hidden clips it at the section boundary. */
  .background-image {
    position: absolute;
    right: 0;
    top: 0;
    width: 38%;
    height: 100vh;
    overflow: hidden;
    border-left: 1px solid var(--border);
    background: var(--bg);
  }

  /* ── Background ───────────────────────────────────────── */
  .background {
    display: grid;
    grid-template-columns: 3rem 1fr 38%;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    position: relative;
  }

  .bg-ghost {
    position: absolute;
    left: 3rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--serif);
    font-size: 45vw;
    font-weight: 900;
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px rgba(237, 233, 224, 0.03);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

