---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map(essay => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const formattedDate = essay.data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${essay.data.title} — Paweł Jarmołkowicz`}
  description={essay.data.description}
>
  <main id="main" class="essay-page">
    <nav class="essay-nav">
      <a href="/essays" class="back-link mono">← Essays</a>
    </nav>

    <article class="essay">
      <header class="essay-header reveal">
        <time class="mono essay-date">{formattedDate}</time>
        <h1 class="serif essay-title">{essay.data.title}</h1>
      </header>

      <div class="essay-body reveal">
        <Content />
      </div>

      <footer class="essay-footer reveal">
        <a href="/essays" class="back-link mono">← All essays</a>
      </footer>
    </article>
  </main>
</Layout>

<!-- Override body background for reading mode -->
<style is:global>
  body:has(.essay-page) {
    background: #faf7f2;
    color: #1a1917;
  }

  body:has(.essay-page) .noise {
    opacity: 0.018;
    mix-blend-mode: multiply;
  }
</style>

<style>
  .essay-page {
    /* Light theme variable overrides */
    --text: #1a1917;
    --dim: rgba(26, 25, 23, 0.5);
    --dim-2: rgba(26, 25, 23, 0.28);
    --border: rgba(26, 25, 23, 0.12);
    --amber: #9e6c0a;

    max-width: 680px;
    margin: 0 auto;
    padding: 4rem var(--edge) 8rem;
    color: var(--text);
  }

  .essay-nav {
    margin-bottom: 4rem;
  }

  .back-link {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--dim);
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--amber);
  }

  .essay-date {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 1rem;
    color: var(--amber);
  }

  .essay-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 3rem;
    max-width: none;
    color: #0d0d0b;
  }

  /* Body: serif for reading comfort on light background */
  .essay-body {
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.9;
    font-weight: 300;
  }

  .essay-body :global(h2) {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1.3;
    margin: 3rem 0 1.25rem;
    color: #0d0d0b;
  }

  .essay-body :global(h3) {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 2.5rem 0 1rem;
  }

  .essay-body :global(p) {
    margin-bottom: 1.5rem;
    max-width: none;
    color: #1a1917;
  }

  .essay-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .essay-body :global(strong) {
    font-weight: 500;
    color: #0d0d0b;
  }

  .essay-body :global(em) {
    font-style: italic;
  }

  .essay-body :global(a) {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(158, 108, 10, 0.35);
    transition: text-decoration-color 0.2s;
  }

  .essay-body :global(a:hover) {
    text-decoration-color: var(--amber);
  }

  .essay-body :global(ul),
  .essay-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .essay-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .essay-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .essay-body :global(blockquote) {
    border-left: 2px solid var(--amber);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--dim);
    font-style: italic;
  }

  .essay-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
