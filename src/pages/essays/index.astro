---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const essays = await getCollection('essays');
const sorted = essays.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Essays — Paweł Jarmołkowicz"
  description="Writing on AI, human capability, professional work, and what technology does to people."
>
  <main id="main" class="essays-page">

    <nav class="essays-nav reveal">
      <a href="/" class="back-link mono dim">← jarmolkowicz.com</a>
    </nav>

    <header class="essays-header reveal">
      <h1 class="serif"><em>Essays</em></h1>
      <p class="header-sub dim">On AI, human capability, and what technology does to people.</p>
    </header>

    <ul class="essays-list">
      {sorted.map((essay, i) => {
        return (
          <li class="essay-item reveal">
            <a href={`/essays/${essay.id}`} class="essay-link">
              <time class="mono dim essay-date">
                {essay.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' })}
              </time>
              <h2 class="serif essay-title">{essay.data.title}</h2>
              <p class="essay-description dim">{essay.data.description}</p>
            </a>
          </li>
        );
      })}
    </ul>

  </main>
</Layout>

<style>
  .essays-page {
    --text: #1a1917;
    --dim: rgba(26, 25, 23, 0.5);
    --dim-2: rgba(26, 25, 23, 0.28);
    --border: rgba(26, 25, 23, 0.12);
    --amber: #9e6c0a;

    max-width: 820px;
    margin: 0 auto;
    padding: 4rem var(--edge) 8rem;
    color: var(--text);
  }

  /* Nav */
  .essays-nav {
    margin-bottom: 4rem;
  }

  .back-link {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--amber);
  }

  /* Header */
  .essays-header {
    margin-bottom: 5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  h1 em {
    font-style: italic;
  }

  .header-sub {
    font-size: 1rem;
    line-height: 1.6;
    max-width: 48ch;
  }

  /* List */
  .essays-list {
    list-style: none;
  }

  .essay-item {
    border-top: 1px solid var(--border);
  }

  .essay-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .essay-link {
    display: block;
    padding: 2.5rem 0;
  }

  .essay-link:hover .essay-title {
    color: var(--amber);
  }

  .essay-title {
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 300;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: color 0.2s;
    max-width: none;
  }

  .essay-date {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.75rem;
  }

  .essay-description {
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 52ch;
  }

</style>

<style is:global>
  body:has(.essays-page) {
    background: #faf7f2;
    color: #1a1917;
  }

  body:has(.essays-page) .noise {
    opacity: 0.018;
    mix-blend-mode: multiply;
  }
</style>
